PORT=4000
NODE_ENV=development

# Password required to sign in to /studio on the client. Set a strong value.
OWNER_PASSWORD=change-me

# Comma-separated list of client origins allowed to call this API with
# credentials. Required in production; ignored in development.
CLIENT_ORIGIN=http://localhost:5173

# Vercel Blob read/write token. Create a Blob store under this project's
# Storage tab on Vercel — it's injected automatically when deployed there.
# For local development, copy the token from that same Storage tab (or run
# `vercel env pull server/.env` after linking this folder to the project).
BLOB_READ_WRITE_TOKEN=
