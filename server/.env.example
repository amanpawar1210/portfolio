PORT=4000
NODE_ENV=development

# Password required to sign in to /studio on the client. Set a strong value.
OWNER_PASSWORD=change-me

# Random string that signs owner session cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# MongoDB connection string. Everything is stored in the "portfolio" database
# (override with MONGODB_DB); the database name in the URI is ignored.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority

# Optional. Only needed if the site is hosted on a different domain from the
# API (the default Vercel setup serves both from one domain).
CLIENT_ORIGIN=
